<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="app_user"/>
            </not>
        </preConditions>

        <createTable tableName="app_user"
                     remarks="пользователь, синхронизируемый из keycloak">
            <column name="id"
                    type="UUID"
                    remarks="идентификатор (uuid v7)">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_app_user"/>
            </column>

            <column name="keycloak_subject"
                    type="TEXT"
                    remarks="subject из токена keycloak">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uidx_app_user__keycloak_subject"/>
            </column>

            <column name="username"
                    type="TEXT"
                    remarks="имя пользователя">
                <constraints nullable="false"/>
            </column>

            <column name="display_name"
                    type="TEXT"
                    remarks="отображаемое имя">
                <constraints nullable="false"/>
            </column>

            <column name="created_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    remarks="время создания">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="llm_credentials"/>
            </not>
        </preConditions>

        <createTable tableName="llm_credentials"
                     remarks="учётные данные llm-провайдера">
            <column name="id"
                    type="UUID"
                    remarks="идентификатор (uuid v7)">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_llm_credentials"/>
            </column>

            <column name="name"
                    type="TEXT"
                    remarks="человекочитаемое имя набора учётных данных">
                <constraints nullable="false"/>
            </column>

            <column name="base_url"
                    type="TEXT"
                    remarks="базовый url openai-совместимого api">
                <constraints nullable="false"/>
            </column>

            <column name="api_key_encrypted"
                    type="TEXT"
                    remarks="зашифрованный api-ключ">
                <constraints nullable="false"/>
            </column>

            <column name="key_version"
                    type="INT"
                    defaultValueNumeric="1"
                    remarks="версия ключа шифрования">
                <constraints nullable="false"/>
            </column>

            <column name="created_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    remarks="время создания">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="llm_model"/>
            </not>
        </preConditions>

        <createTable tableName="llm_model"
                     remarks="конфигурация модели llm-провайдера">
            <column name="id"
                    type="UUID"
                    remarks="идентификатор (uuid v7)">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_llm_model"/>
            </column>

            <column name="credentials_id"
                    type="UUID"
                    remarks="ссылка на учётные данные провайдера">
                <constraints nullable="false"
                             foreignKeyName="fk_llm_model__credentials_id__llm_credentials_id"
                             referencedTableName="llm_credentials"
                             referencedColumnNames="id"/>
            </column>

            <column name="model_id"
                    type="TEXT"
                    remarks="имя модели у провайдера">
                <constraints nullable="false"/>
            </column>

            <column name="params_jsonb"
                    type="JSONB"
                    remarks="дополнительные параметры модели"/>

            <column name="created_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    remarks="время создания">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="agent"/>
            </not>
        </preConditions>

        <createTable tableName="agent"
                     remarks="иммутабельная ревизия агента">
            <column name="id"
                    type="UUID"
                    remarks="идентификатор ревизии (uuid v7)">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_agent"/>
            </column>

            <column name="key"
                    type="TEXT"
                    remarks="логическое имя агента">
                <constraints nullable="false"/>
            </column>

            <column name="name"
                    type="TEXT"
                    remarks="человекочитаемое имя для каталога агентов">
                <constraints nullable="false"/>
            </column>

            <column name="description"
                    type="TEXT"
                    remarks="описание агента"/>

            <column name="rev"
                    type="INT"
                    remarks="номер ревизии">
                <constraints nullable="false"/>
            </column>

            <column name="role_prompt"
                    type="TEXT"
                    remarks="системный промпт агента">
                <constraints nullable="false"/>
            </column>

            <column name="tools_jsonb"
                    type="JSONB"
                    remarks="декларация инструментов агента"/>

            <column name="permissions_jsonb"
                    type="JSONB"
                    remarks="разрешения агента"/>

            <column name="skills_jsonb"
                    type="JSONB"
                    remarks="навыки агента"/>

            <column name="llm_model_id"
                    type="UUID"
                    remarks="ссылка на конфигурацию модели">
                <constraints nullable="false"
                             foreignKeyName="fk_agent__llm_model_id__llm_model_id"
                             referencedTableName="llm_model"
                             referencedColumnNames="id"/>
            </column>

            <column name="created_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    remarks="время создания ревизии">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="5"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="agent"
                             indexName="uidx_agent__key_rev"/>
            </not>
        </preConditions>

        <addUniqueConstraint tableName="agent"
                             columnNames="key, rev"
                             constraintName="uidx_agent__key_rev"/>
    </changeSet>

    <changeSet id="6"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="session"/>
            </not>
        </preConditions>

        <createTable tableName="session"
                     remarks="сессия агента (журнал и метаданные)">
            <column name="id"
                    type="UUID"
                    remarks="идентификатор сессии (uuid v7)">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_session"/>
            </column>

            <column name="title"
                    type="TEXT"
                    remarks="название сессии"/>

            <column name="owner_user_id"
                    type="UUID"
                    remarks="ссылка на пользователя-владельца">
                <constraints nullable="false"
                             foreignKeyName="fk_session__owner_user_id__app_user_id"
                             referencedTableName="app_user"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>

            <column name="kind"
                    type="VARCHAR(16)"
                    remarks="вид сессии">
                <constraints nullable="false"/>
            </column>

            <column name="task_id"
                    type="UUID"
                    remarks="ссылка на задачу для сессий состояния"/>

            <column name="state_code"
                    type="TEXT"
                    remarks="код состояния ревизии задачи"/>

            <column name="agent_revision_id"
                    type="UUID"
                    remarks="ссылка на ревизию агента, закреплённую при создании">
                <constraints foreignKeyName="fk_session__agent_revision_id__agent_id"
                             referencedTableName="agent"
                             referencedColumnNames="id"/>
            </column>

            <column name="parent_session_id"
                    type="UUID"
                    remarks="ссылка на родительскую сессию для субагентов">
                <constraints foreignKeyName="fk_session__parent_session_id__session_id"
                             referencedTableName="session"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>

            <column name="cancel_requested"
                    type="BOOLEAN"
                    defaultValueBoolean="false"
                    remarks="признак запроса отмены текущего хода">
                <constraints nullable="false"/>
            </column>

            <column name="last_seq"
                    type="BIGINT"
                    defaultValueNumeric="0"
                    remarks="максимальный seq сообщений сессии">
                <constraints nullable="false"/>
            </column>

            <column name="last_consumed_seq"
                    type="BIGINT"
                    defaultValueNumeric="0"
                    remarks="последний seq, вошедший в законченный модельный ход">
                <constraints nullable="false"/>
            </column>

            <column name="last_turn_outcome"
                    type="VARCHAR(16)"
                    remarks="исход последнего хода"/>

            <column name="last_activity_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    remarks="время последней активности">
                <constraints nullable="false"/>
            </column>

            <column name="created_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    remarks="время создания">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="7"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="session"
                             indexName="uidx_session__task_id_state_code"/>
            </not>
        </preConditions>

        <sql>
            CREATE UNIQUE INDEX uidx_session__task_id_state_code
                ON session (task_id, state_code)
                WHERE kind = 'STATE';
        </sql>
    </changeSet>

    <changeSet id="8"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="session"
                             indexName="idx_session__last_seq_pending"/>
            </not>
        </preConditions>

        <sql>
            CREATE INDEX idx_session__last_seq_pending
                ON session (last_seq)
                WHERE last_seq > last_consumed_seq;
        </sql>
    </changeSet>

    <changeSet id="9"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM pg_constraint
                WHERE conname = 'ck_session__kind'
            </sqlCheck>
        </preConditions>

        <sql>
            ALTER TABLE session
                ADD CONSTRAINT ck_session__kind CHECK (kind IN ('FREE', 'STATE'));
        </sql>
    </changeSet>

    <changeSet id="10"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM pg_constraint
                WHERE conname = 'ck_session__last_turn_outcome'
            </sqlCheck>
        </preConditions>

        <sql>
            ALTER TABLE session
                ADD CONSTRAINT ck_session__last_turn_outcome
                    CHECK (last_turn_outcome IS NULL OR last_turn_outcome IN ('COMPLETED', 'FAILED', 'CANCELLED'));
        </sql>
    </changeSet>

    <changeSet id="11"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="session_message"/>
            </not>
        </preConditions>

        <createTable tableName="session_message"
                     remarks="append-only сообщение журнала сессии">
            <column name="session_id"
                    type="UUID"
                    remarks="ссылка на сессию">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_session_message"
                             foreignKeyName="fk_session_message__session_id__session_id"
                             referencedTableName="session"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>

            <column name="seq"
                    type="BIGINT"
                    remarks="сквозная нумерация в пределах сессии">
                <constraints nullable="false"
                             primaryKey="true"/>
            </column>

            <column name="id"
                    type="TEXT"
                    remarks="неизменяемый идентификатор события (ulid)">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uidx_session_message__id"/>
            </column>

            <column name="kind"
                    type="VARCHAR(16)"
                    remarks="вид события">
                <constraints nullable="false"/>
            </column>

            <column name="author_user_id"
                    type="UUID"
                    remarks="ссылка на автора для сообщений пользователя">
                <constraints foreignKeyName="fk_session_message__author_user_id__app_user_id"
                             referencedTableName="app_user"
                             referencedColumnNames="id"/>
            </column>

            <column name="payload_jsonb"
                    type="JSONB"
                    remarks="контент события">
                <constraints nullable="false"/>
            </column>

            <column name="tokens"
                    type="INT"
                    remarks="учёт стоимости вызова"/>

            <column name="created_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    remarks="время создания">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="12"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM pg_constraint
                WHERE conname = 'ck_session_message__kind'
            </sqlCheck>
        </preConditions>

        <sql>
            ALTER TABLE session_message
                ADD CONSTRAINT ck_session_message__kind
                    CHECK (kind IN ('USER', 'ASSISTANT', 'SYSTEM', 'TOOL_CALL', 'TOOL_RESULT', 'COMPACT'));
        </sql>
    </changeSet>

    <changeSet id="13"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="shedlock"/>
            </not>
        </preConditions>

        <createTable tableName="shedlock"
                     remarks="таблица блокировок shedlock (джобы и сессионные локи)">
            <column name="name"
                    type="VARCHAR(64)"
                    remarks="имя блокировки">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_shedlock"/>
            </column>

            <column name="lock_until"
                    type="TIMESTAMP"
                    remarks="блокировка действует до этого момента">
                <constraints nullable="false"/>
            </column>

            <column name="locked_at"
                    type="TIMESTAMP"
                    remarks="момент взятия блокировки">
                <constraints nullable="false"/>
            </column>

            <column name="locked_by"
                    type="VARCHAR(255)"
                    remarks="владелец блокировки">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
