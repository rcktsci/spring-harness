<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="llm_credentials"/>
            </not>
        </preConditions>

        <createTable tableName="llm_credentials"
                     remarks="учётные данные llm-провайдера">
            <column name="id"
                    type="UUID"
                    remarks="идентификатор (uuid v7)">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_llm_credentials"/>
            </column>

            <column name="name"
                    type="TEXT"
                    remarks="человекочитаемое имя набора учётных данных">
                <constraints nullable="false"/>
            </column>

            <column name="base_url"
                    type="TEXT"
                    remarks="базовый url openai-совместимого api">
                <constraints nullable="false"/>
            </column>

            <column name="api_key_encrypted"
                    type="TEXT"
                    remarks="зашифрованный api-ключ">
                <constraints nullable="false"/>
            </column>

            <column name="key_version"
                    type="INT"
                    defaultValueNumeric="1"
                    remarks="версия ключа шифрования">
                <constraints nullable="false"/>
            </column>

            <column name="created_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    remarks="время создания">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
