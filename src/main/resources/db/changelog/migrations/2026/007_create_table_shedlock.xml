<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="13"
               author="rocket-science">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="shedlock"/>
            </not>
        </preConditions>

        <createTable tableName="shedlock"
                     remarks="таблица блокировок shedlock (джобы и сессионные локи)">
            <column name="name"
                    type="VARCHAR(64)"
                    remarks="имя блокировки">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_shedlock"/>
            </column>

            <column name="lock_until"
                    type="TIMESTAMP"
                    remarks="блокировка действует до этого момента">
                <constraints nullable="false"/>
            </column>

            <column name="locked_at"
                    type="TIMESTAMP"
                    remarks="момент взятия блокировки">
                <constraints nullable="false"/>
            </column>

            <column name="locked_by"
                    type="VARCHAR(255)"
                    remarks="владелец блокировки">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
