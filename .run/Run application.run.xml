<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Run application" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <module name="spring-harness" />
    <option name="SPRING_BOOT_MAIN_CLASS" value="se.rocketscien.harness.HarnessApplication" />
    <option name="WORKING_DIRECTORY" value="file://$MODULE_WORKING_DIR$" />
    <extension name="coverage">
      <pattern>
        <option name="PATTERN" value="se.rocketscien.harness.*" />
        <option name="ENABLED" value="true" />
      </pattern>
    </extension>
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>